{
  "name": "eslint-plugin-capo",
  "version": "0.1.0",
  "description": "ESLint plugin to validate HTML <head> elements based on capo.js rules",
  "main": "src/index.js",
  "type": "module",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "html",
    "head",
    "validation",
    "capo",
    "performance",
    "seo"
  ],
  "author": "Rick Viscomi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rviscomi/eslint-plugin-capo.git"
  },
  "peerDependencies": {
    "@html-eslint/parser": ">=0.47.0",
    "eslint": ">=8.21.0"
  },
  "devDependencies": {
    "@html-eslint/parser": "^0.49.0",
    "dedent": "^1.7.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js tests/*.test.js",
    "test:rules": "node --test tests/rules/*.test.js",
    "test:utils": "node --test tests/utils/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.js tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,md,json,html}": "prettier --write"
  },
  "dependencies": {
    "@rviscomi/capo.js": "file:../capo.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
